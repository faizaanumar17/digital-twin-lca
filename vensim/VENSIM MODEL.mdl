{UTF-8}
Rehab capacity km=Annual Budget GBP / Weighted rehab Unit Cost
	~	km/Year
	~		|

Initial acceptable total km=Total network km-Initial backlog km
	~	km
	~		~	:SUPPLEMENTARY 
	|

Acceptable km asphalt= INTEG (Rehab Asphalt-Deterioration asphalt,
		Initial acceptable km asphalt)
	~	km
	~		|

Acceptable KM Laterite= INTEG (Rehab Laterite-Deterioration laterite,
		Initial acceptable km laterite)
	~	km
	~		|

Acceptable KM plastic= INTEG (Rehab Plastic-Deterioration Plastic,
		Initial acceptable km plastic)
	~	km
	~		|

Annual Budget GBP=Budget Factor*Baseline annual budget GBP
	~	GBP/Year
	~		~	:SUPPLEMENTARY 
	|

Annual CO2 Addition t=(Rehab Asphalt*Unit rehab CO2 asphalt)+(Rehab Laterite*Unit rehab CO2 laterite\
		)+(Rehab Plastic*Unit rehab CO2 plastic)
	~	t/Year
	~		|

Annual Cost Addition GBP=(Rehab Asphalt * Unit Rehab Cost asphalt)
	+ (Rehab Laterite * Unit Rehab Cost laterite)
	+ (Rehab Plastic * Unit Rehab Cost plastic)
	~	GBP/Year
	~		|

Backlog KM= INTEG (Total Deterioration-Total Rehab,
		Initial backlog km)
	~	km
	~		|

Backlog Fraction=Backlog KM/Total network km
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

Baseline annual budget GBP=844794
	~	GBP/Year
	~		|

Budget Factor=1
	~	Dmnl
	~		|

Cumulative CO2 t= INTEG (Annual CO2 Addition t,
		0)
	~	t
	~		~	:SUPPLEMENTARY 
	|

Cumulative Cost GBP= INTEG (Annual Cost Addition GBP,
		0)
	~	GBP
	~		~	:SUPPLEMENTARY 
	|

Deterioration laterite=Acceptable KM Laterite / MAX(Effective TTL Laterite, 0.001)
	~	km/Year
	~		|

Deterioration Plastic=Acceptable KM plastic / MAX(Effective TTL Plastic, 0.001)
	~	km/Year
	~		|

Deterioration asphalt=Acceptable km asphalt / MAX(Effective TTL asphalt, 0.001)
	~	km/Year
	~		|

Unit rehab CO2 asphalt=23.5078
	~	t/km
	~		|

Unit rehab CO2 laterite=3.82907
	~	t/km
	~		|

Unit rehab CO2 plastic=24.771
	~	t/km
	~		|

Unit Rehab Cost asphalt=21256.9
	~	GBP/km
	~		|

Unit Rehab Cost laterite=11820.8
	~	GBP/km
	~		|

Unit Rehab Cost plastic=26067.1
	~	GBP/km
	~		|

Weighted rehab Unit Cost=((Rehab share asphalt*Unit Rehab Cost asphalt)+(Rehab share laterite\
		*Unit Rehab Cost laterite)+Rehab share plastic*Unit Rehab Cost plastic)
	~	GBP/km
	~		~	:SUPPLEMENTARY 
	|

Rehab response time=1
	~	Year
	~	Assumed response time for converting backlog demand into a rehabilitation flow.
	|

Rehab Plastic=min ((Backlog KM*Rehab share plastic)/Rehab response time,Rehab capacity km*Rehab share plastic\
		)
	~	km/Year
	~		|

Total Rehab=Rehab Asphalt+Rehab Laterite+Rehab Plastic
	~	km/Year
	~		|

Rehab Asphalt=min((Backlog KM*Rehab share asphalt)/Rehab response time,Rehab capacity km*Rehab share asphalt\
		)
	~	km/Year
	~		|

Total Deterioration=Deterioration laterite+Deterioration Plastic+Deterioration asphalt
	~	km/Year
	~		|

Rehab Laterite=min ((Backlog KM*Rehab share laterite)/Rehab response time,Rehab capacity km*Rehab share laterite\
		)
	~	km/Year
	~		|

Total acceptable km=Acceptable km asphalt+Acceptable KM Laterite+Acceptable KM plastic
	~	km
	~		|

Initial acceptable km plastic=8.5
	~	km
	~		|

Initial acceptable km laterite=17
	~	km
	~		|

Initial backlog km=15
	~	km
	~		|

Initial acceptable km asphalt=59.5
	~	km
	~		|

Acceptable fraction=Total acceptable km / Total network km
	~	Dmnl
	~		~	:SUPPLEMENTARY 
	|

Effective TTL asphalt=TTL asphalt/Overload damage multiplier
	~	Year
	~		|

Effective TTL Laterite=TTL laterite/Overload damage multiplier
	~	Year
	~		|

Effective TTL Plastic=TTL Plastic/Overload damage multiplier
	~	Year
	~		|

Overload damage multiplier=1
	~	Dmnl
	~		|

Rehab share asphalt=0.7
	~	Dmnl
	~		|

Rehab share laterite=0.2
	~	Dmnl
	~		|

Rehab share plastic=0.1
	~	Dmnl
	~		|

Total network km=100
	~	km
	~		|

TTL asphalt=5
	~	Year
	~		|

TTL laterite=3.33333
	~	Year
	~		|

TTL Plastic=7
	~	Year
	~		|

